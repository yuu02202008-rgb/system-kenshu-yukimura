# Copy this file to .env, then replace both passwords with private local values.
# Never commit .env or reuse a production password here.
WEB_PORT=8000
TASKS_PORT=8001
PMA_PORT=8080
MYSQL_HOST_PORT=3307

MYSQL_ROOT_PASSWORD=replace-with-a-long-local-root-password
MYSQL_DATABASE=training
MYSQL_USER=training_user
MYSQL_PASSWORD=replace-with-a-long-local-app-password

# WEB_PORT: ブラウザー用HTTPポート。TASKS_PORT: 第1週PHPフォーム。
# PMA_PORT: 任意phpMyAdmin。MYSQL_HOST_PORT: PCからDBへ接続するポート。
# MYSQL_DATABASE: 初期DB名（教材SQLはtraining）。MYSQL_USER: アプリ用ユーザー。
# MYSQL_PASSWORD: アプリ用DBパスワード。MYSQL_ROOT_PASSWORD: 初期管理用。
# DB_HOSTはCompose内でdatabase固定。DB_NAME/USER/PASSは上記をPHPへ渡す。
